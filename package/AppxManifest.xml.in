<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenInVim - Windows 11 File Explorer context menu for Vim
  Copyright (C) 2026 Sylvain Cresto
  SPDX-License-Identifier: GPL-3.0-or-later

  MSIX package manifest.  The version, architecture and publisher
  placeholders are filled by make_package.ps1.

  The identity name and the publisher display name are the ones reserved
  in Microsoft Partner Center (Store ID 9ND5KG4GSKBD); the publisher of the
  Store package is CN=4D7AE54D-4897-4AAF-AD4A-96A83C99020F.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap rescap desktop4 desktop5 com">
  <Identity Name="SylvainCresto.OpenInVim" ProcessorArchitecture="@ARCH@"
            Publisher="@PUBLISHER@" Version="@VERSION@" />
  <Properties>
    <DisplayName>OpenInVim</DisplayName>
    <PublisherDisplayName>Sylvain Cresto</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Open files and folders with Vim from the Windows 11 context menu. Requires Vim.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <!-- Languages of src/lang/*.rc, the first one is the default. -->
    <Resource Language="en-us" />
    <Resource Language="fr" />
  </Resources>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="OpenInVim" Executable="OpenInVim.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <!-- Every package needs an application: OpenInVim.exe is the
           settings window, listed in the Start menu. -->
      <uap:VisualElements DisplayName="OpenInVim"
                          Description="Open files and folders with Vim from the Windows 11 context menu"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <!-- A single verb, so that Explorer shows it at the root of the
                   menu (several verbs are grouped in a submenu).  The same
                   verb is declared for files and folders. -->
              <desktop5:Verb Id="EditWithVim"
                             Clsid="E54BE61C-5500-4B02-BA4E-DF54462656E8" />
            </desktop5:ItemType>
            <!-- Folders: Vim shows them with netrw. -->
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="EditWithVim"
                             Clsid="E54BE61C-5500-4B02-BA4E-DF54462656E8" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="OpenInVim">
              <com:Class Id="E54BE61C-5500-4B02-BA4E-DF54462656E8"
                         Path="OpenInVim.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
