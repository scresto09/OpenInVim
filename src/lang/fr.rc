LANGUAGE LANG_FRENCH, SUBLANG_NEUTRAL

STRINGTABLE
BEGIN
    IDS_EDIT_IN_VIM         "Modifier dans Vim"
    IDS_OPEN_IN_VIM         "Ouvrir dans Vim"

    IDS_SETTINGS_TITLE      "Paramètres d'OpenInVim"
    IDS_GROUP_GVIM          "gVim"
    IDS_GVIM_LABEL          "Chemin de gvim.exe :"
    IDS_GVIM_CUE            "Détection automatique"
    IDS_BROWSE              "&Parcourir..."
    IDS_STATUS_AUTO         "Détecté automatiquement : "
    IDS_STATUS_NOT_FOUND    "gVim est introuvable : choisissez gvim.exe, ou installez Vim avec l'installeur officiel.  En attendant, l'entrée du menu reste masquée."
    IDS_STATUS_MISSING      "Ce fichier n'existe pas."
    IDS_GROUP_OPEN          "Ouverture des fichiers"
    IDS_USE_TABS            "Ouvrir chaque fichier dans un nouvel &onglet"
    IDS_CANCEL              "Annuler"
    IDS_VERSION             "Version "
    IDS_LICENSE             "Logiciel libre sous licence <a href=""https://www.gnu.org/licenses/gpl-3.0.html"">GNU GPL v3</a>."
    IDS_BROWSE_TITLE        "Choisir gvim.exe"
    // "|" separates the filter name and its pattern.
    IDS_BROWSE_FILTER       "gvim.exe|gvim.exe|Programmes (*.exe)|*.exe|"
    IDS_ERROR_MISSING       "L'exécutable gVim choisi n'existe pas."
    IDS_ERROR_SAVE          "Les paramètres n'ont pas pu être enregistrés."
END
