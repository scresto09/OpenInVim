//
// Resources of OpenInVim.exe, the settings window.  The texts of the dialog
// are set at run time from the translated string tables (lang/*.rc).  The
// icon is generated from package/icon/*.svg.

#include <windows.h>
#include "resource.h"
#include "strings.h"

IDI_OPENINVIM ICON "openinvim.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "openinvim_app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 310, 202
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenInVim"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_OPENINVIM, IDC_HEADER_ICON, 10, 10, 21, 20
    LTEXT           "OpenInVim", IDC_TITLE, 40, 8, 263, 14
    LTEXT           "", IDC_SUBTITLE, 40, 24, 263, 9

    GROUPBOX        "", IDC_GROUP_GVIM, 7, 42, 296, 62
    LTEXT           "", IDC_GVIM_LABEL, 15, 55, 280, 9
    EDITTEXT        IDC_GVIM_PATH, 15, 66, 222, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_BROWSE, 242, 65, 53, 16
    LTEXT           "", IDC_GVIM_STATUS, 15, 84, 280, 16

    GROUPBOX        "", IDC_GROUP_OPEN, 7, 110, 296, 30
    AUTOCHECKBOX    "", IDC_USE_TABS, 15, 123, 280, 10

    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 7, 148, 296, 1
    CONTROL         "", IDC_ABOUT, "SysLink", WS_TABSTOP, 7, 154, 296, 20

    DEFPUSHBUTTON   "OK", IDOK, 196, 180, 50, 15
    PUSHBUTTON      "", IDCANCEL, 253, 180, 50, 15
END

// Translations
#include "lang/en.rc"
#include "lang/fr.rc"
